{$PAYLASH_DOMAIN} {
	tls internal

	encode gzip

	request_body {
		max_size 200MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		# Defense-in-depth: no script/style/image/media/frame may load from any
		# third-party origin (blocks the exact "external CDN" pattern the removed
		# Google Fonts dependency used, and a large class of exfiltration/backdoor
		# payloads that rely on fetching a remote resource). 'unsafe-inline' stays
		# on script-src/style-src because this frontend is built with inline
		# onclick="..." handlers and inline style="..." throughout (no build step,
		# no framework) — a real script-src without it would need rewriting every
		# handler to addEventListener first, which is its own separate project.
		#
		# connect-src also allows PAYLASH_MINIO_PUBLIC_ENDPOINT: large-file
		# uploads PUT part bytes straight from the browser to MinIO on that
		# host:port (web/js/upload.js, internal/api/uploads.go), a different
		# origin than this site since it's a different port — without this,
		# every such fetch() is silently blocked by the browser and every
		# upload past LARGE_FILE_THRESHOLD (50MB) fails with "Failed to
		# fetch". Only https: is listed since that endpoint is now always
		# TLS-terminated by the site block below, matching this site's own
		# scheme (see there for why). When the endpoint var is unset
		# (resumable upload disabled) this becomes "https://" with no host,
		# which the CSP grammar treats as invalid and simply drops — harmless.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self'; connect-src 'self' https://{$PAYLASH_MINIO_PUBLIC_ENDPOINT}; worker-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	# Collabora — static assets, WOPI discovery, WebSocket/API.
	# reverse_proxy preserves the original Host header and upgrades the
	# connection automatically for the ws paths, same as the old nginx config.
	@collabora path /browser/* /hosting/* /cool/* /lool/*
	reverse_proxy @collabora paylash-collabora:9980

	# Everything else (app UI, /api/, /wopi/) → the Paylash app.
	reverse_proxy paylash-app:8080
}

# MinIO S3 API, TLS-terminated here so the browser's direct-to-MinIO
# large-file upload PUTs (web/js/upload.js, presigned by
# internal/api/uploads.go) share this site's HTTPS scheme. MinIO itself only
# ever speaks plain HTTP (Docker-internal traffic) — a browser refuses
# "mixed content" fetch()/XHR from an HTTPS page to a plain-http origin with
# no way to opt out, so once the main site is HTTPS this one has to be too.
# reverse_proxy is a dumb byte-pump, same as it already is for every other
# request through this Caddyfile, so the actual file bytes still never touch
# the Go app process — only where TLS gets terminated changes.
{$PAYLASH_DOMAIN}:9000 {
	tls internal
	reverse_proxy paylash-minio:9000
}
